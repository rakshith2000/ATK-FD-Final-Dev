        "jsdom": "^29.0.2",
        "postcss": "^8.5.30",
        "prettier": "^3.9.10",
        "sass": "^1.105.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4",
        "web-vitals": "^5.2.0"
    },
    "optionalDependencies": {
        "@rolldown/binding-darwin-arm64": "*",
        "@rolldown/binding-darwin-x64": "*",
        "@rolldown/binding-linux-x64-gnu": "*",
