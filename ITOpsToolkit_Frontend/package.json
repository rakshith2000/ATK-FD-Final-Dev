{
    "name": "itops-toolkit-ui",
    "private": true,
    "version": "2.3",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build:mfe": "vite build --config vite.config.itops-mfe.ts && tsc",
        "dev:mfe": "vite build --config vite.config.itops-mfe.ts && vite preview --outDir dist/itops-mfe --port 3000",
        "build": "vite build && tsc",
        "lint:check": "eslint src --no-cache",
        "lint:report": "eslint src -f json -o .eslint/eslint-report.json --no-cache",
        "prettier:check": "prettier --check .",
        "prettier:fix": "prettier --write .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "node -e \"if(process.env.HUSKY==='0'||process.env.CI){process.exit(0)}else{require('child_process').execSync('cd .. && npx husky ITOpsToolkit_Frontend/.husky',{stdio:'inherit'})}\"",
        "pre-commit": "npm run test && npm run prettier:check && npm run lint:check && npm run build"
    },
    "dependencies": {
        "@azure/msal-browser": "^5.25.0",
        "@base-ui/react": "^1.9.0",
        "@emotion/react": "^11.14.0",
