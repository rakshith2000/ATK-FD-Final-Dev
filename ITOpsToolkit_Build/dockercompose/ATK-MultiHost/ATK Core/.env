# =============================================================================
# ATK CORE machine (10.106.6.15) — Environment Variables
# Hosts: Vault, Keycloak, Backend, Grafana, LiteLLM, Postgres, nginx
#
# Fill in all <Placeholder> values before running docker compose up
# =============================================================================

# ── DNS / Hostnames ───────────────────────────────────────────────────────────
# ── DNS / Domain Configuration ────────────────────────────────────────────────
# One record per component instead of a single host with path routing.
#   sso-atkdev / vault-atkdev / backend-atkdev -> 10.106.6.15 (this VM)
#   autonomousitopstoolkitdev                  -> 10.106.6.228 (frontend VM)
KEYCLOAK_DNS=sso-atkdev.familydollar.com
VAULT_DNS=vault-atkdev.familydollar.com
BACKEND_DNS=backend-atkdev.familydollar.com
FRONTEND_DNS=autonomousitopstoolkitdev.familydollar.com

# The two remaining hostnames are NOT read from here — change them in the file
# listed next to each, or they will have no effect:
#   vault-atkdev.fd.com  -> config/nginx.conf  (server_name of the Vault block)
#   atkdev.fd.com        -> config/.keycloak_env (KEYCLOAK_REDIRECTION_URL)
#
# nginx cannot read .env, so every server_name in config/nginx.conf is literal.
# If you rename any hostname, update config/nginx.conf too.

# ── PostgreSQL (Main DB) ──────────────────────────────────────────────────────
POSTGRES_USER=itops_user
POSTGRES_PASSWORD=Password-1
POSTGRES_DB=itopstoolkit_maf_db

# ── Backend application database ──────────────────────────────────────────────
# Point at the local "postgres" container, or at an external / RDS instance.
DB_HOST=10.106.6.16
DB_PORT=5432
DB_NAME=itopstoolkit_maf_db
PGDB_HOST=10.106.6.16
PGDB_PORT=5432
PGDB_NAME=itopstoolkit_maf_db

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=AIOT
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASS=keycloak@123

# ── Keycloak Client IDs & Secrets ─────────────────────────────────────────────
KEYCLOAK_BACKEND_CLIENT_ID=aiot-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=OBvoiKFyCg************************8SORT42IoA4pUgZplqKpxAT5FBA
KEYCLOAK_FRONTEND_CLIENT_ID=aiot-frontend
KEYCLOAK_AGW_CLIENT_ID=agw-cli
KEYCLOAK_GRAFANA_CLIENT_ID=grafana-oAuth
KEYCLOAK_GRAFANA_CLIENT_SECRET=j9Rl0LvKboOxf0XoNYFo56ugmuxWmIYDTaXcF65OkdLo5esYcShMX7H1dlStJGFjPdbBAbI3TJKtMZN2S1mZoT

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=litellm@123
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin@123
LITELLM_DB=litellm_db
LITELLM_DB_USER=litellm_user
LITELLM_DB_PASS=litellm@123

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin@123

# ── Agent Gateway ─────────────────────────────────────────────────────────────
AGENT_GATEWAY_PORT=3000
AGENT_GATEWAY_ADMIN_PORT=15000
AGENT_GATEWAY_UI_PORT=19000
AGENT_GATEWAY_ADMIN_GROUP=Agentgateway-Admin

# ── ServiceNow / ITSM ─────────────────────────────────────────────────────────
SNOW_URL=https://fddev.service-now.com         # e.g. https://yourinstance.service-now.com
SNOW_USER=svc_itops_toolkit
SNOW_PASSWORD=b2K.YvY.8****************oDq4WNE
ITSM_TAG=snow_dev
ITSM_TYPE=servicenow
ITSM_AUTH_TYPE=service_account
KB_BASES=Help Desk Associate – FD,IT Application Support            # comma-separated KB base names
KB_FIELDS=sys_id, number, short_description, text, kb_category, author, rating, kb_knowledge_base          # comma-separated fields to index

# ── MIM Assist & Communication (Optional) ─────────────────────────────────────
MIM_APP_PORT=3978
TWILIO_PHONE_NUMBER_FROM=
PROACTIVE_PROBLEM_ANALYSIS_DAYS=30

# ── Service Account Credentials ───────────────────────────────────────────────
SA_CLIENT_ID=<YOUR_SERVICE_ACCOUNT_CLIENT_ID>
SA_CLIENT_SECRET=<YOUR_SERVICE_ACCOUNT_CLIENT_SECRET>

# ── ServiceNow scope enforcement ──────────────────────────────────────────────
# Keep "on" while ServiceNow is accessed through the service account: it makes
# the backend scope every browser-originated query to the signed-in user, the
# way ATK 2.1's typed endpoints did.
# Switch to "off" only after moving to per-user ServiceNow OAuth (set
# serviceNow.api.mode = "direct" in the frontend's app-config.json), where
# ServiceNow enforces its own ACLs instead.
SNOW_SCOPE_ENFORCEMENT=on
SNOW_SCOPE_CACHE_TTL=60
